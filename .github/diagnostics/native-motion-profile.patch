+private let nativeCpuProfileLog = OSLog(subsystem: "dev.fardavide.granita.native-cpu-profile", category: "PointsOfInterest")
+
+private enum NativeCpuProfileCase: String {
+    case dense
+    case selector
+}
+
+private struct NativeCpuProfileMetadata: Encodable {
+    let processId: Int32
+    let bundleId: String
+    let caseName: String
+    let uptime: Double
+    let monotonic: Double
+    let wallTime: Double
+    let operatingSystem: String
+    let areAnimationsEnabled: Bool
+    let isReduceMotionEnabled: Bool
+    let applicationState: Int
+    let swiftUiReduceMotion: String
+}
+
+@MainActor
+private func waitForNativeCpuRecorder(for profile: NativeCpuProfileCase) async throws {
+    let base = "/private/tmp/granita-ci-native-motion-" + profile.rawValue
+    let readyUrl = URL(filePath: base + ".ready.json")
+    let armedPath = base + ".armed"
+    try #require(FileManager.default.fileExists(atPath: readyUrl.path) == false)
+    try #require(FileManager.default.fileExists(atPath: armedPath) == false)
+    let metadata = NativeCpuProfileMetadata(
+        processId: ProcessInfo.processInfo.processIdentifier,
+        bundleId: try #require(Bundle.main.bundleIdentifier),
+        caseName: profile.rawValue,
+        uptime: ProcessInfo.processInfo.systemUptime,
+        monotonic: CACurrentMediaTime(),
+        wallTime: Date().timeIntervalSince1970,
+        operatingSystem: ProcessInfo.processInfo.operatingSystemVersionString,
+        areAnimationsEnabled: UIView.areAnimationsEnabled,
+        isReduceMotionEnabled: UIAccessibility.isReduceMotionEnabled,
+        applicationState: UIApplication.shared.applicationState.rawValue,
+        swiftUiReduceMotion: "unavailable: the existing harness does not expose the SwiftUI environment value"
+    )
+    let data = try JSONEncoder().encode(metadata)
+    try data.write(to: readyUrl, options: .atomic)
+    Attachment.record(Array(data), named: "native-cpu-ready-" + profile.rawValue + ".json")
+    let deadline = ContinuousClock.now.advanced(by: .seconds(240))
+    while FileManager.default.fileExists(atPath: armedPath) == false {
+        try #require(ContinuousClock.now < deadline, "CPU recorder did not start before the setup deadline")
+        try await Task.sleep(for: .milliseconds(10))
+    }
+}
